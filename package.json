{
  "name": "delta-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "lint:report": "node scripts/lint-report.mjs",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint:css && npm run lint:report && npm run lint:a11y && npm run test:unit && npm run build && npm run test:e2e",
    "quality:summary": "node scripts/quality-summary.mjs",
    "sonar": "node scripts/sonar.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint:commits": "sh scripts/lint-commits.sh",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test:logic": "vitest run --config vitest.logic.config.js",
    "test:component": "vitest run test/App.test.jsx",
    "lint:a11y": "eslint --config eslint.a11y.config.js \"src/**/*.jsx\"",
    "sonar:host": "node scripts/sonar-host.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
